{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.0.5",
  "description": "__MSG_extDescription__",
  "default_locale": "pt_BR",
  "permissions": [
    "alarms",
    "downloads",
    "storage",
    "offscreen",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://api.polar.sh/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokv.com/*",
    "https://*.byteoversea.com/*",
    "https://*.byteimg.com/*",
    "https://*.ibyteimg.com/*",
    "https://*.muscdn.com/*",
    "https://*.akamaized.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "instagram/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "instagram/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "tiktok/media-validation.js",
        "tiktok/parser.js",
        "tiktok/interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": [
        "tiktok/parser.js",
        "tiktok/profile-filters.js",
        "tiktok/content.js"
      ],
      "css": [
        "tiktok/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "24": "assets/icon24.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "instagram/worker.js"
      ],
      "matches": [
        "https://www.instagram.com/*"
      ]
    },
    {
      "resources": [
        "tiktok/media-validation.js",
        "tiktok/parser.js",
        "tiktok/interceptor.js"
      ],
      "matches": [
        "https://*.tiktok.com/*"
      ]
    }
  ]
}
