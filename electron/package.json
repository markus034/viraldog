{
  "name": "viraldog-desktop",
  "version": "1.1.0",
  "description": "ViralDog Desktop App — Download, editar e publicar Reels no Instagram",
  "author": "ViralDog",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/download-manager.test.js",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "archiver": "^6.0.1"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.viraldog.app",
    "productName": "ViralDog",
    "copyright": "Copyright © 2025 ViralDog",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "ViralDog",
      "legalTrademarks": "ViralDog",
      "requestedExecutionLevel": "asInvoker",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ViralDog",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "ViralDog",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "../backend/dist/main",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": ["**/*"]
      },
      {
        "from": "extensions",
        "to": "extensions",
        "filter": ["**/*"]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "preload-browser.js",
      "browser-identity.js",
      "external-browser.js",
      "download-manager.js",
      "extension-polyfills.js",
      "ig-browser.js",
      "instagram-session.js",
      "assets/**",
      "extensions/**"
    ],
    "asar": true
  }
}
